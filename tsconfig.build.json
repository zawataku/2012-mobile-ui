{
  // ライブラリの型定義（dist/types）を出力する
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist/types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.build.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/main.ts", "src/test", "src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.stories.tsx"]
}
